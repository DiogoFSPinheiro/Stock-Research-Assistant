# Runtime mode
BOT_MODE=signal_only
BOT_LOG_LEVEL=INFO
BOT_STORAGE_PATH=data/state.json

# Capital and risk
BOT_CAPITAL=100000
BOT_RISK_PER_TRADE=0.005
BOT_MAX_OPEN_POSITIONS=4
BOT_MAX_DAILY_LOSS=0.02
BOT_MAX_WEEKLY_LOSS=0.05
BOT_REWARD_TO_RISK=2.0
BOT_SIGNAL_EXPIRY_MINUTES=240
BOT_POLL_SECONDS=300

# Signal universe
BOT_ALLOWED_FX=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD
BOT_ALLOWED_STOCKS=AAPL,MSFT,AMZN,NVDA,GOOGL,META,TSLA,BRK.B,JNJ,JPM
BOT_CONTEXT_SYMBOLS=SPX500,GOLD,BTCUSD
BOT_ALLOWED_TIMEFRAMES=H4,D1

# Market data provider
# Use `synthetic` for local dry runs or `alpha_vantage` for live market data.
MARKET_DATA_PROVIDER=synthetic
ALPHA_VANTAGE_API_KEY=replace-me
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=20

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=123456789
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_POLLING_LIMIT=25
TELEGRAM_DROP_PENDING_UPDATES_ON_START=false

# Deprecated XTB execution settings
# These are retained only for older local setups. The project no longer places trades on XTB.
XTB_ACCOUNT_MODE=demo
XTB_USER_ID=demo-user
XTB_PASSWORD=demo-password
XTB_HOST=ws.xtb.com
XTB_PORT=5124
XTB_USE_TLS=true
XTB_WEBSOCKET_URL=wss://ws.xtb.com/demo
XTB_STREAM_WEBSOCKET_URL=wss://ws.xtb.com/demoStream
XTB_APP_NAME=xtb-trading-bot
