# Research assistant runtime
# `BOT_MODE` remains for compatibility with older local setups.
BOT_MODE=signal_only
BOT_LOG_LEVEL=INFO
BOT_STORAGE_PATH=data/state.json

# Legacy scoring and risk controls kept while the shortlist engine is still signal-backed.
BOT_CAPITAL=100000
BOT_RISK_PER_TRADE=0.005
BOT_MAX_OPEN_POSITIONS=4
BOT_MAX_DAILY_LOSS=0.02
BOT_MAX_WEEKLY_LOSS=0.05
BOT_REWARD_TO_RISK=2.0
BOT_SIGNAL_EXPIRY_MINUTES=240
BOT_POLL_SECONDS=1800
BOT_AUTO_SCAN_HOUR=9
BOT_AUTO_SCAN_MINUTE=0
BOT_PORTFOLIO_PATH=config/portfolio.txt

# Research watchlist
BOT_ALLOWED_FX=
BOT_ALLOWED_STOCKS=
BOT_STOCK_UNIVERSE_PATH=config/stock_universe.txt
BOT_CONTEXT_SYMBOLS=SPY,QQQ,GLD
BOT_ALLOWED_TIMEFRAMES=D1

# Market data provider
# `yfinance` is the default live-data path for the research-first experience.
# `synthetic` remains useful for local dry runs and reproducible tests.
MARKET_DATA_PROVIDER=yfinance
YFINANCE_PERIOD=1y
YFINANCE_INTERVAL=1d
YFINANCE_TIMEOUT_SECONDS=20
YFINANCE_USE_ADJUSTED_CLOSE=true
YFINANCE_AUTO_ADJUST=false
YFINANCE_PREPOST=false

# Alpha Vantage is currently limited to price-history style usage in this project.
ALPHA_VANTAGE_API_KEY=replace-me
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=20

# Telegram delivery
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_POLLING_LIMIT=25
TELEGRAM_DROP_PENDING_UPDATES_ON_START=false
